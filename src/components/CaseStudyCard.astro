---
interface Image {
  src: string;
  caption?: string;
}

interface Props {
  title: string;
  company: string;
  summary: string;
  role: string;
  year: number;
  href: string;
  tags?: string[];
  image?: string;
  images?: Image[];
  workInProgress?: boolean;
  transitionName?: string;
}

const {
  title, company, summary, role, year, href,
  tags = [], image, images, workInProgress = false, transitionName,
} = Astro.props;

const rotating = images && images.length > 1 ? images : null;
const single   = rotating ? null : (images?.[0]?.src ?? image);
const rotateId = rotating ? `rotate-${Math.random().toString(36).slice(2, 8)}` : null;
---

<a href={href} class="card" aria-label={`${title} — ${company}`}>
  <div class="card__visual" id={rotateId ?? undefined} transition:name={transitionName}>
    {rotating
      ? rotating.map((img, i) => (
          <img
            src={img.src}
            alt=""
            role="presentation"
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
            class:list={['card__img', { 'card__img--active': i === 0 }]}
          />
        ))
      : single
        ? <img src={single} alt="" role="presentation" loading="lazy" decoding="async" class="card__img card__img--active" />
        : <span class="label card__placeholder">{company}</span>
    }
    {workInProgress && (
      <span class="card__wip" aria-label="Work in progress">Work in progress</span>
    )}
  </div>

  <div class="card__body">
    <div class="card__head">
      <p class="card__company label">{company}</p>
      <span class="card__arrow" aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 12L12 2M12 2H4M12 2V10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </div>

    <h3 class="card__title">{title}</h3>
    <p class="card__summary">{summary}</p>

    <p class="card__meta">
      <span>{role}</span>
      <span class="card__meta-sep" aria-hidden="true">·</span>
      <span>{year}</span>
    </p>

    {tags.length > 0 && (
      <ul class="card__tags" aria-label="Tags">
        {tags.map(tag => <li class="card__tag">{tag}</li>)}
      </ul>
    )}
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    /* ease-expo is right for entrances, but on a 3px hover lift it puts 27%
       of the travel in the first frame, which reads as a jump. */
    transition: transform var(--dur-mid) var(--ease-in-out);
  }

  /* Keyboard focus gets the same affordance as the mouse, not just the ring. */
  .card:is(:hover, :focus-visible) {
    transform: translateY(-3px);
  }

  /* ── Image tile ── */
  .card__visual {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color var(--dur-mid) var(--ease-in-out);
  }

  .card:is(:hover, :focus-visible) .card__visual {
    border-color: var(--c-border-strong);
  }

  .card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    opacity: 0;
    /* 0.8s crossfade is the image rotation; the hover zoom matches the
       card lift so the whole hover state lands at once. */
    transition: opacity 0.8s ease, transform var(--dur-mid) var(--ease-in-out);
  }

  .card__img--active {
    opacity: 1;
  }

  .card:is(:hover, :focus-visible) .card__img {
    transform: scale(1.03);
  }

  .card__placeholder {
    color: var(--c-ink-subtle);
  }

  .card__wip {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    z-index: 2;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: #E8A020;
    color: #fff;
    padding: 0.25em 0.7em;
    border-radius: 2px;
    white-space: nowrap;
    pointer-events: none;
  }

  /* ── Text below ── */
  .card__body {
    padding-top: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .card__company {
    color: var(--c-accent);
  }

  .card__arrow {
    flex-shrink: 0;
    color: var(--c-ink-subtle);
    transition: transform var(--dur-mid) var(--ease-in-out),
                color var(--dur-mid) var(--ease-in-out);
    display: block;
  }

  .card:is(:hover, :focus-visible) .card__arrow {
    transform: translate(2px, -2px);
    color: var(--c-ink-mid);
  }

  .card__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--c-ink);
  }

  .card__summary {
    font-size: var(--text-sm);
    font-weight: 300;
    color: var(--c-ink-mid);
    line-height: 1.6;
    /* Keep every tile the same height regardless of summary length */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.15rem;
    font-size: var(--text-sm);
    color: var(--c-ink-subtle);
    line-height: 1.5;
  }

  .card__meta-sep {
    color: var(--c-border-strong);
  }

  .card__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.25rem;
  }

  .card__tag {
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-ink-subtle);
    border: 1px solid var(--c-border);
    padding: 0.2em 0.55em;
    border-radius: 1px;
    transition: border-color var(--dur-mid) var(--ease-in-out),
                color var(--dur-mid) var(--ease-in-out);
  }

  .card:is(:hover, :focus-visible) .card__tag {
    border-color: var(--c-border-strong);
    color: var(--c-ink-mid);
  }
</style>

{rotateId && (
  <script define:vars={{ rotateId }} data-astro-rerun>
    const wrap = document.getElementById(rotateId);
    if (wrap) {
      const imgs = wrap.querySelectorAll('.card__img');
      if (imgs.length > 1) {
        let current = 0;
        const iv = setInterval(() => {
          // Self-clean once this card is swapped away by view transitions
          if (!wrap.isConnected) { clearInterval(iv); return; }
          imgs[current].classList.remove('card__img--active');
          current = (current + 1) % imgs.length;
          imgs[current].classList.add('card__img--active');
        }, 2500);
      }
    }
  </script>
)}

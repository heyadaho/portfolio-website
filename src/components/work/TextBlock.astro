---
interface Props {
  label?: string;
  heading?: string;
}

const { label, heading } = Astro.props;
---

<section class="text-block section">
  <div class="container container--text">

    {label && <span class="label text-block__label">{label}</span>}
    {heading && <h2 class="text-block__heading">{heading}</h2>}

    <div class="text-block__body">
      <slot />
    </div>

  </div>
</section>

<style>
  .text-block__label {
    display: block;
    margin-bottom: 0.4rem;
  }

  .text-block__heading {
    font-size: var(--text-2xl);
    font-weight: 400;
    letter-spacing: -0.022em;
    line-height: 1.12;
    margin-bottom: 2rem;
    /* 22ch left ~115px of the text container unused, wrapping headings a line early. */
    max-width: 28ch;
  }

  .text-block__body {
    font-size: var(--text-md);
    font-weight: 300;
    color: var(--c-ink-mid);
    line-height: 1.75;
  }

  /* MDX content arrives through <slot>, so it carries no scope attribute. */
  .text-block__body :global(p) {
    max-width: 62ch;
  }

  .text-block__body :global(p + p) {
    margin-top: 1.1em;
  }

  /* Tailwind's preflight strips list markers and the global reset zeroes
     padding, so both have to be put back explicitly. */
  .text-block__body :global(ul),
  .text-block__body :global(ol) {
    margin-block: 1em;
    padding-left: 1.4em;
    display: flex;
    flex-direction: column;
    gap: 0.5em;
  }

  .text-block__body :global(ul) { list-style: disc; }
  .text-block__body :global(ol) { list-style: decimal; }

  .text-block__body :global(li) {
    max-width: 60ch;
  }
</style>

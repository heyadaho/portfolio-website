---
import CaseStudyCard from './CaseStudyCard.astro';
import { getCollection } from 'astro:content';

const byOrder = (a: any, b: any) => (a.data.order ?? 99) - (b.data.order ?? 99);

const ai = (await getCollection('ai')).sort(byOrder).map(e => ({
  key:     `ai-${e.id}`,
  order:   e.data.order ?? 99,
  href:    `/ai/${e.id}`,
  title:   e.data.title,
  company: e.data.company ?? '',
  summary: e.data.summary,
  role:    e.data.role ?? '',
  year:    e.data.year ?? 0,
  tags:    e.data.tags ?? [],
  image:   e.data.heroImages?.[0]?.src ?? e.data.image,
  images:  e.data.heroImages,
  workInProgress: e.data.workInProgress ?? false,
  transitionName: undefined as string | undefined,
}));

const work = (await getCollection('work')).sort(byOrder).map(e => ({
  key:     `work-${e.id}`,
  order:   e.data.order ?? 99,
  href:    `/work/${e.id}`,
  title:   e.data.title,
  company: e.data.company,
  summary: e.data.summary,
  role:    e.data.role,
  year:    e.data.year,
  tags:    e.data.tags ?? [],
  image:   e.data.image,
  images:  undefined,
  workInProgress: false,
  transitionName: `work-img-${e.id}`,
}));

/* Newest first; `order` breaks ties within a year. */
const studies = [...ai, ...work].sort(
  (a, b) => b.year - a.year || (a.order - b.order),
);
---

<section class="work section" id="work">
  <div class="container">

    <div class="work__header" data-reveal>
      <span class="label">Case Studies</span>
    </div>

    {studies.length === 0 ? (
      <p class="work__empty">Case studies coming soon.</p>
    ) : (
      <div class="work__grid">
        {studies.map((s, i) => (
          <div data-reveal style={`--reveal-i: ${i % 3}`}>
            <CaseStudyCard
              title={s.title}
              company={s.company}
              summary={s.summary}
              role={s.role}
              year={s.year}
              href={s.href}
              tags={s.tags}
              image={s.image}
              images={s.images}
              workInProgress={s.workInProgress}
              transitionName={s.transitionName}
            />
          </div>
        ))}
      </div>
    )}

  </div>
</section>

<style>
  /* The nav is fixed, so #work has to stop short of it. */
  .work {
    scroll-margin-top: 6rem;
  }

  .work__header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--c-border);
  }

  .work__empty {
    color: var(--c-ink-subtle);
    font-size: var(--text-md);
  }

  .work__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem 1.5rem;
  }

  @media (min-width: 700px) {
    .work__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.75rem 1.5rem;
    }
  }

  @media (min-width: 1100px) {
    .work__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
